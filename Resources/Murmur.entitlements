<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Opening a recording at the moment that matched asks QuickTime Player to go there (macOS asks you once). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Murmur: dictation records the microphone (the hardened runtime blocks it without this). -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- "What's on my calendar?", "my reminders": read through EventKit (the hardened runtime blocks it without this). -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
